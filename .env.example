# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/recruitment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@company.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=recruiting@company.com

# Calendar API (Google Calendar)
GOOGLE_CALENDAR_CREDENTIALS_PATH=./config/google_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./config/token.json

# Video Interview Platform
VIDEO_PLATFORM=zoom  # zoom, teams, or custom
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret

# AWS Configuration (if using S3 for resume storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=recruitment-resumes

# Application Settings
APP_NAME=AI Recruitment System
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,https://yourcompany.com

# Screening Thresholds
MIN_RESUME_SCORE=0.45
STRONG_MATCH_THRESHOLD=0.75
PROCEED_TO_INTERVIEW_THRESHOLD=0.60

# Interview Settings
VIDEO_INTERVIEW_DURATION_MINUTES=30
MIN_INTERVIEW_SCORE=7.5
MAX_QUESTIONS_PER_INTERVIEW=7

# Bias Mitigation
ENABLE_BIAS_AUDITING=True
ADVERSE_IMPACT_THRESHOLD=0.80  # 4/5ths rule

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_INTERVIEWS=5
